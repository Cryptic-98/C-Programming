@model StayBnB.Models.ViewModels.PropertyCardViewModel

<article class="property-card">
    <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Id" class="property-card-media">
        <img src="@(Model.PrimaryImageUrl ?? "/img/properties/pretoria-apartment.jpg")" alt="@Model.Title in @Model.City" loading="lazy" />
        <span class="property-card-badge">Guest favourite</span>
    </a>
    <div class="property-card-body">
        <div class="property-card-header">
            <h3 class="property-card-title">@Model.Title</h3>
            <div class="property-card-rating">
                <i class="bi bi-star-fill"></i>
                <span>@(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.00") : "New")</span>
            </div>
        </div>
        <p class="property-card-meta">@Model.City, South Africa</p>
        <p class="property-card-meta">@Model.MaxGuests guests · @Model.Bedrooms bedroom@(Model.Bedrooms == 1 ? "" : "s")</p>
        <p class="property-card-price"><strong>R @Model.PricePerNight.ToString("N0")</strong> night</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Guest"))
    {
        <form asp-controller="Wishlist" asp-action="Toggle" method="post" style="position:absolute; top:12px; right:12px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="propertyId" value="@Model.Id" />
            <button type="button" class="wishlist-button @(Model.IsWishlisted ? "is-saved" : "")" data-wishlist-toggle data-property-id="@Model.Id" aria-pressed="@(Model.IsWishlisted ? "true" : "false")">
                <i class="bi @(Model.IsWishlisted ? "bi-heart-fill" : "bi-heart") wishlist-icon"></i>
            </button>
        </form>
    }
</article>

<style>
    .property-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: var(--sb-3);
    }
    .property-card-media {
        position: relative;
        border-radius: var(--sb-r-md);
        overflow: hidden;
        aspect-ratio: 20/19;
    }
    .property-card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .2s ease;
    }
    .property-card-media:hover img {
        transform: scale(1.03);
    }
    .property-card-badge {
        position: absolute;
        left: 12px;
        top: 12px;
        background: rgba(255,255,255,.95);
        padding: 4px 10px;
        border-radius: var(--sb-r-pill);
        font-size: 12px;
        font-weight: 600;
    }
    .property-card-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .property-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sb-3);
    }
    .property-card-title {
        font-size: 16px;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .property-card-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 14px;
    }
    .property-card-rating .bi-star-fill {
        font-size: 12px;
    }
    .property-card-meta {
        margin: 0;
        color: var(--sb-text-2);
        font-size: 14px;
    }
    .property-card-price {
        margin: 4px 0 0;
        font-size: 15px;
    }
    .wishlist-button {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,.9);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
    }
    .wishlist-button.is-saved {
        color: var(--sb-blue-600);
    }
</style>
