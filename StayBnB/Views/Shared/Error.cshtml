@{
    ViewData["Title"] = "Error";
}

<div class="container" style="padding-top:64px; padding-bottom:64px; text-align:center; display:flex; flex-direction:column; align-items:center; gap:16px;">
    <div style="width:72px;height:72px;border-radius:50%;background:var(--sb-danger-bg);display:flex;align-items:center;justify-content:center;color:var(--sb-danger);font-size:32px;">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h1>Something went wrong</h1>
    <p style="color:var(--sb-text-2);">An error occurred while processing your request. Please try again or return to the homepage.</p>
    <a asp-controller="Home" asp-action="Index" class="sb-btn sb-btn--primary">Back to home</a>
</div>
