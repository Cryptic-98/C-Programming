@model StayBnB.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Sign up";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Sign up</h1>
            <p>Create your Staybnb account to book stays or become a host</p>
        </div>
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" asp-for="FirstName"></label>
                    <input class="form-input" asp-for="FirstName" />
                    <span class="field-validation-error" asp-validation-for="FirstName"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="LastName"></label>
                    <input class="form-input" asp-for="LastName" />
                    <span class="field-validation-error" asp-validation-for="LastName"></span>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-input" asp-for="Email" placeholder="you@example.com" />
                <span class="field-validation-error" asp-validation-for="Email"></span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-input" asp-for="Password" />
                <span class="field-validation-error" asp-validation-for="Password"></span>
                <small class="form-help" style="font-size:13px;">Must be at least 8 characters and include upper, lower case and a digit.</small>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-input" asp-for="ConfirmPassword" />
                <span class="field-validation-error" asp-validation-for="ConfirmPassword"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" style="margin-bottom:12px;"></div>
            <button type="submit" class="sb-btn sb-btn--primary" style="width:100%;">Create account</button>
        </form>
        <div class="auth-footer">
            <span>Already have an account?</span>
            <a asp-action="Login">Log in</a>
        </div>
    </div>
</div>

<style>
    .auth-wrap {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--sb-6) var(--sb-4);
        background: linear-gradient(180deg, #fff 0%, var(--sb-bg-alt) 100%);
    }
    .auth-card {
        width: min(520px, 100%);
        background: #fff;
        border: 1px solid var(--sb-border-soft);
        border-radius: var(--sb-r-lg);
        box-shadow: var(--sb-shadow-card-up);
        padding: clamp(24px, 6vw, 40px);
        display: flex;
        flex-direction: column;
        gap: var(--sb-5);
    }
    .auth-header h1 { margin: 0 0 6px; }
    .auth-header p { margin: 0; color: var(--sb-text-2); }
    .auth-footer {
        text-align: center;
        color: var(--sb-text-2);
        display: flex;
        gap: 8px;
        justify-content: center;
    }
</style>
